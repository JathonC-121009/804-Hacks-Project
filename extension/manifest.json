{
  "manifest_version": 3,
  "name": "Output-Waste Optimizer",
  "version": "0.1.0",
  "description": "Improves prompts before you send and tracks aggregate AI efficiency across tools without uploading conversation text.",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok*",
    "https://poe.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://you.com/*",
    "https://www.you.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://poe.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://you.com/*",
        "https://www.you.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["loader.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/*", "config/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Output-Waste Optimizer" }
}
