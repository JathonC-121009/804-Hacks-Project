# Local secrets. Git ignores this file (.gitignore: ".env"), so a key put here
# is never committed. Do not paste a key anywhere else in the repo.
#
# EIA_API_KEY powers `npm run grid`, which replaces the seeded grid data in
# data/grid_pjm.json with real hourly PJM fuel-mix data from the US Energy
# Information Administration.
#
# Get one (free, instant, no card):
#   1. Open https://www.eia.gov/opendata/register.php
#   2. Enter your name and email, submit.
#   3. The key arrives by email in a minute or two. It looks like a 40-character
#      string of letters and numbers.
#   4. Paste it after the = below, with no quotes and no spaces.
#   5. Run: npm run grid
#
# Nothing else in this project needs a key. The portal, the extension, the
# tests and the seeded demo data all run without one.

EIA_API_KEY=
